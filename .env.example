# Application Configuration
APP_NAME="DoubleTick WhatsApp for Bitrix24"
APP_URL=https://your-public-domain.com
APP_ENV=production
APP_DEBUG=false

# DoubleTick API Credentials (Settings -> Developer Documentation in DoubleTick)
DOUBLETICK_API_KEY=your_doubletick_api_key_here
DOUBLETICK_DEFAULT_WABA=919999999999
DOUBLETICK_API_URL=https://public.doubletick.io
DOUBLETICK_WEBHOOK_SECRET=

# Bitrix24 Local App OAuth Credentials (Developer Resources -> Other -> Local Application in Bitrix24)
B24_CLIENT_ID=local.xxxxxxxxxxxx.xxxxxxxx
B24_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database Configuration (sqlite or mysql)
DB_DRIVER=sqlite
# For MySQL uncomment below:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=doubletick_b24
# DB_USER=root
# DB_PASS=
